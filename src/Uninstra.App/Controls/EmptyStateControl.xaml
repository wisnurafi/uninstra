<UserControl x:Class="Uninstra.App.Controls.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Premium minimal empty state (Linear-style): large muted vector glyph at 40%
        opacity, quiet semibold title, muted supporting copy, one optional action
        slot centered below the text. All content is driven by dependency
        properties — see EmptyStateControl.xaml.cs for usage examples.
    -->
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="40,36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel>
            <Path x:Name="PART_Icon"
                  Width="48"
                  Height="48"
                  Stretch="Uniform"
                  Fill="{DynamicResource TextMutedBrush}"
                  Opacity="0.4"
                  HorizontalAlignment="Center"
                  Visibility="Collapsed"/>
            <TextBlock x:Name="PART_Title"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="PART_Message"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="{DynamicResource TextMutedBrush}"
                       MaxWidth="360"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <ContentPresenter x:Name="PART_Action"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
