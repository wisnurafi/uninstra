<Application x:Class="Uninstra.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Uninstra.App.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:BoolToOnOffConverter x:Key="BoolToOnOff"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <conv:CountToVisibilityInverseConverter x:Key="CountToVisibilityInverse"/>
            <conv:FileSizeConverter x:Key="FileSizeConverter"/>
            <conv:FileSizeConverter x:Key="BytesToSizeConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <conv:DateFormatConverter x:Key="DateFormatConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
