<UserControl x:Class="Uninstra.App.Views.Pages.BrowserExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Browser Extensions" FontSize="20" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                            CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Extensions.Count, FallbackValue=0}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Manage extensions across Chrome, Firefox, Edge, and more" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20,0">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Extensions}" IsReadOnly="True"
                          AutoGenerateColumns="False" SelectionMode="Single" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Extension" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="100"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding IsEnabled}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Loading overlay -->
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Background="{DynamicResource GlassBackgroundBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="32"
                    Visibility="{Binding Extensions.Count, FallbackValue=Visible, Converter={StaticResource CountToVisibilityInverse}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{DynamicResource Icon_Puzzle}" Fill="{DynamicResource TextMutedBrush}"
                              Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                    </Border>
                    <TextBlock Text="No extensions found" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Extensions from installed browsers will appear here" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,8,20,12">
            <DockPanel>
                <Button Content="Refresh" Style="{DynamicResource SecondaryButton}"
                        DockPanel.Dock="Right" Padding="14,6" FontSize="12"
                        Command="{Binding LoadCommand}" ToolTip="Rescan browser extensions"/>
                <TextBlock Text="{Binding StatusText}" FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
