<UserControl x:Class="Uninstra.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- Operation type icon: keyed vector geometry per OperationType -->
        <Style x:Key="OperationTypeIcon" TargetType="Path">
            <Setter Property="Data" Value="{DynamicResource Icon_History}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="NormalUninstall">
                    <Setter Property="Data" Value="{DynamicResource Icon_Delete}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="DeepUninstall">
                    <Setter Property="Data" Value="{DynamicResource Icon_Shield}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="ForceUninstall">
                    <Setter Property="Data" Value="{DynamicResource Icon_ForceUninstall}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="BatchUninstall">
                    <Setter Property="Data" Value="{DynamicResource Icon_SelectAll}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="LeftoverCleanup">
                    <Setter Property="Data" Value="{DynamicResource Icon_FolderOpen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="ResidualScan">
                    <Setter Property="Data" Value="{DynamicResource Icon_ResidualScan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="JunkCleanup">
                    <Setter Property="Data" Value="{DynamicResource Icon_JunkCleaner}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="QuarantineRestore">
                    <Setter Property="Data" Value="{DynamicResource Icon_Restore_Item}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="QuarantineDelete">
                    <Setter Property="Data" Value="{DynamicResource Icon_Trash}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="BrowserExtensionRemoval">
                    <Setter Property="Data" Value="{DynamicResource Icon_BrowserExtensions}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.OperationType}" Value="AppxRemoval">
                    <Setter Property="Data" Value="{DynamicResource Icon_WindowsApps}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status badge pill: Success = lime-green, Failed = red, else warning amber -->
        <Style x:Key="StatusBadgeBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Record.Status}" Value="Completed">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.Status}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Record.Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Record.Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="History" FontSize="20" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                                CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Records.Count, FallbackValue=0}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="View past uninstall and cleanup operations" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource GhostButton}" Command="{Binding LoadCommand}"
                            Padding="14,7" ToolTip="Reload uninstall history">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource Icon_Refresh}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearAllCommand}" Margin="8,0,0,0"
                            Style="{DynamicResource DangerButton}" Padding="14,8" FontSize="12"
                            ToolTip="Delete every record from uninstall history">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource Icon_Trash}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: history list OR premium empty state -->
        <Grid Grid.Row="1">
            <!-- History list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Records.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Records}" Margin="20,4,20,8"
                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource GlassCard}" CornerRadius="10"
                                    Padding="16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Operation type icon -->
                                    <Path Grid.Column="0" Style="{StaticResource OperationTypeIcon}"
                                          Fill="{DynamicResource PrimaryBrush}" Opacity="0.9"
                                          Width="22" Height="22" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <!-- Name / meta -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ApplicationName}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TypeName}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                    Margin="0,3,0,0">
                                            <TextBlock Text="{Binding StartedAt, Converter={StaticResource DateFormatConverter}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>

                                            <!-- Items cleaned -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasItemsCleaned, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="  ·  " FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding ItemsCleaned, StringFormat='{}{0} items cleaned'}"/>
                                            </StackPanel>

                                            <!-- Space recovered -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasRecoveredBytes, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="  ·  " FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding RecoveredBytes, Converter={StaticResource FileSizeConverter}, StringFormat='{}{0} recovered'}"/>
                                            </StackPanel>

                                            <!-- Warnings -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="  ·  " FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Text="{Binding WarningCount, StringFormat='{}{0} warnings'}"/>
                                            </StackPanel>

                                            <!-- Publisher -->
                                            <TextBlock Text="{Binding Publisher}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Publisher, Converter={StaticResource StringToVisibility}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status badge -->
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeBorder}"
                                            Background="{DynamicResource GlassHighlightBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource StatusBadgeText}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Premium empty state -->
            <Border Margin="20,0" Padding="0,24"
                    Visibility="{Binding Records.Count, Converter={StaticResource CountToVisibilityInverse}}">
                <Border Background="{DynamicResource GlassBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="32"
                        VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="420">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="400">
                        <!-- Large muted vector icon -->
                        <Path Data="{DynamicResource Icon_History}"
                              Fill="{DynamicResource TextMutedBrush}" Opacity="0.4"
                              Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Text="No history yet" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <TextBlock Text="Your uninstall and cleanup operations will appear here once you remove your first program."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,20"/>

                        <!-- In-card action -->
                        <Button Style="{DynamicResource GhostButton}" Command="{Binding LoadCommand}"
                                Padding="16,7" FontSize="12" HorizontalAlignment="Center"
                                ToolTip="Reload uninstall history">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Refresh}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear button inside card (kept) -->
                        <Button Click="ClearButton_Click" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#15EF4444"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="16,8"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#25EF4444"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#35EF4444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Trash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear History" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText, FallbackValue=Empty}" FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="20,0,20,12"/>
    </Grid>
</UserControl>
