<UserControl x:Class="Uninstra.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20,24,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="History" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="View past uninstall and cleanup operations" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Clear All" Style="{StaticResource DangerButton}"
                        Padding="14,7" FontSize="12" VerticalAlignment="Center"
                        Click="ClearButton_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,0,24,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📜" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                <TextBlock Text="No history yet" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Your uninstall history will appear here" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Empty" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                   Margin="24,0,24,12"/>
    </Grid>
</UserControl>
