<UserControl x:Class="Uninstra.App.Views.Pages.InstallMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20,24,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Install Monitor" FontSize="22" FontWeight="SemiBold"/>
                    <Border Background="#15EF4444" BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IsMonitoring, Converter={StaticResource BoolToOnOff}, FallbackValue=OFF}"
                                   FontSize="12" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Monitor new installations and track changes in real-time" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,0,24,0" VerticalAlignment="Center">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="32,28" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="Install monitoring" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <TextBlock Text="Select an installer to monitor. Uninstra will take a system snapshot before and after installation to track all changes."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                    <!-- Installer path display -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0"
                            Visibility="{Binding InstallerPath, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding InstallerPath}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallerPath}"/>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Browse Installer..." Style="{StaticResource SecondaryButton}"
                        Padding="20,10" FontSize="13" Margin="0,0,8,0"
                        Command="{Binding BrowseInstallerCommand}"
                        ToolTip="Select an installer (.exe or .msi) to monitor"/>
                <Button Content="Start Monitoring" Style="{StaticResource PrimaryButton}"
                        Padding="20,10" FontSize="13"
                        Command="{Binding StartMonitoringCommand}"
                        ToolTip="Take snapshot and run the installer"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="24,0,24,12"/>
    </Grid>
</UserControl>
