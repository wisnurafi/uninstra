<UserControl x:Class="Uninstra.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Configure application preferences" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings Sections -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,16">
            <StackPanel>
                <!-- General -->
                <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource GlassBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Create restore point before uninstall" FontSize="13"/>
                                <TextBlock Text="Automatically create a Windows restore point" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding CreateRestorePoint}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Confirm before uninstall" FontSize="13"/>
                                <TextBlock Text="Show confirmation dialog before uninstalling" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding ConfirmBeforeUninstall}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Confirm before cleanup" FontSize="13"/>
                                <TextBlock Text="Show confirmation dialog before cleaning leftovers" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding ConfirmBeforeCleanup}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Advanced mode" FontSize="13"/>
                                <TextBlock Text="Show advanced options and system components" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding AdvancedMode}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Scanning -->
                <TextBlock Text="SCANNING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource GlassBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Scan AppData folder" FontSize="13"/>
                                <TextBlock Text="Search for leftovers in AppData" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding ScanAppData}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Scan ProgramData folder" FontSize="13"/>
                                <TextBlock Text="Search for leftovers in ProgramData" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding ScanProgramData}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Scan Registry" FontSize="13"/>
                                <TextBlock Text="Search for leftover registry entries" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding ScanRegistry}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Scan Startup entries" FontSize="13"/>
                                <TextBlock Text="Check for leftover startup items" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                      IsChecked="{Binding ScanStartup}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Data -->
                <TextBlock Text="DATA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource GlassBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Clear scan cache" FontSize="13"/>
                                <TextBlock Text="Remove cached scan results" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{DynamicResource SecondaryButton}"
                                    Padding="12,6" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Reset all settings" FontSize="13"/>
                                <TextBlock Text="Restore default configuration" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" Style="{DynamicResource DangerButton}"
                                    Padding="12,6" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Save Button -->
        <Border Grid.Row="2" Padding="20,8,20,12">
            <DockPanel>
                <Button Content="Save Settings" Style="{DynamicResource PrimaryButton}"
                        DockPanel.Dock="Right" Padding="16,8" FontSize="12"
                        Command="{Binding SaveCommand}" ToolTip="Save current settings"/>
                <TextBlock Text="Changes are saved to JSON config file" FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
