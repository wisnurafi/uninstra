<UserControl x:Class="Uninstra.App.Views.Pages.SoftwareHealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20,24,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Software Health" FontSize="22" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                            CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Items.Count, FallbackValue=0}" FontSize="12"
                                   Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Analyze installed software for issues, risks, and recommendations" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,0">
            <!-- Results list -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20,16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Severity}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AffectedCount, StringFormat={}{0} items}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Loading overlay -->
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="Analyzing software health..." FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="24,8,24,12">
            <DockPanel>
                <Button Content="Rescan" Style="{StaticResource SecondaryButton}"
                        DockPanel.Dock="Right" Padding="16,6" FontSize="12"
                        Command="{Binding LoadCommand}" ToolTip="Rescan software health"/>
                <TextBlock Text="{Binding Items.Count, StringFormat={}{0} issues found, FallbackValue=Ready}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
