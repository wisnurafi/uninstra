<UserControl x:Class="Uninstra.App.Views.Pages.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Uninstra.App.Converters"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:DateFormatConverter x:Key="DateFormatConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="24,20,24,16">
            <DockPanel>
                <!-- Title + count -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Programs" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                                CornerRadius="10" Padding="10,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalPrograms}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryLightBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage and deep-uninstall your programs" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadCommand}" Padding="14,7" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ SEARCH BAR ═══ -->
        <Border Grid.Row="0" Padding="24,0,24,0" VerticalAlignment="Bottom" Margin="0,0,0,-20">
            <!-- Overlapping search bar is handled by row 1 margin -->
        </Border>

        <!-- ═══ TABLE ═══ -->
        <Border Grid.Row="1" Margin="24,4,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search row -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBox}"
                             Width="320" DockPanel.Dock="Left">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Programs}"
                          SelectedItem="{Binding SelectedProgram}"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Single"
                          CanUserReorderColumns="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Program Name" Binding="{Binding DisplayName}" Width="*" MinWidth="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate, Converter={StaticResource DateFormatConverter}}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Uninstall" Style="{StaticResource DangerButton}"
                                            Padding="10,4" FontSize="11" FontWeight="Normal"
                                            Command="{Binding DataContext.UninstallSingleCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Deep uninstall: removes program + leftover files"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ BOTTOM ACTION BAR ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                CornerRadius="10" Padding="20,12" Margin="24,12,24,4"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                            CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryLightBrush}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text=" selected"/>
                        </TextBlock>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                        <Run Text="Total: "/>
                        <Run Text="{Binding SelectedTotalSize, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Uninstall Selected" Style="{StaticResource DangerButton}"
                            Command="{Binding UninstallSelectedCommand}" Margin="0,0,8,0"
                            Padding="16,8" FontSize="12"
                            ToolTip="Deep uninstall all selected programs"/>
                    <Button Content="Clear" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearSelectionCommand}" Padding="12,8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="3" Padding="24,6,24,10">
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Border>

        <!-- ═══ LOADING OVERLAY ═══ -->
        <Border Grid.RowSpan="4" CornerRadius="0"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BackgroundColor}" Opacity="0.85"/>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="3" Margin="0,0,0,16"/>
                <TextBlock Text="Scanning installed programs..." FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
