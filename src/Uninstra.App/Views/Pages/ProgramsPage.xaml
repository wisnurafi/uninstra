<UserControl x:Class="Uninstra.App.Views.Pages.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Uninstra.App.Converters"
             xmlns:local="clr-namespace:Uninstra.App.Views.Pages"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:DateFormatConverter x:Key="DateFormatConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:FirstLetterConverter x:Key="FirstLetter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <Grid>
                <!-- Title + count -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Programs" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                                CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalPrograms}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage and deep-uninstall your programs" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Refresh button - icon only, elegant -->
                <Button Command="{Binding LoadCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="36" Height="36">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PressedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{DynamicResource Icon_Refresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="16" Height="16" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource SearchTextBox}"
                         Width="280" DockPanel.Dock="Left">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- Data Grid -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Programs}"
                          SelectedItem="{Binding SelectedProgram}"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Single"
                          CanUserReorderColumns="True"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Checkbox column - fixed width, centered -->
                        <DataGridTemplateColumn Header="" Width="50" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Program Name -->
                        <DataGridTextColumn Header="Program Name" Binding="{Binding DisplayName}" Width="*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Publisher -->
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Version -->
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Size -->
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Installed -->
                        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate, Converter={StaticResource DateFormatConverter}}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="" Width="60" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{DynamicResource IconButton}"
                                            Command="{Binding DataContext.UninstallSingleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Deep uninstall"
                                            Width="32" Height="32">
                                        <Path Data="{DynamicResource Icon_Trash}" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ═══ DETAIL PANEL — selected program ═══ -->
        <Border Grid.Row="2" Margin="20,10,20,0"
                Visibility="{Binding SelectedProgram, Converter={StaticResource NullToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Letter avatar -->
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                            Background="{DynamicResource PrimaryTranslucentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedProgram.DisplayName, Converter={StaticResource FirstLetter}}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Name + metadata -->
                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedProgram.DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedProgram.Publisher}"
                                       FontSize="11" Margin="12,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <TextBlock Text="Version" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProgram.Version}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProgram.Size, Converter={StaticResource FileSizeConverter}}"
                                           FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <TextBlock Text="Installed" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProgram.InstallDate, Converter={StaticResource DateFormatConverter}, TargetNullValue='—'}"
                                           FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <TextBlock Text="Installer" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProgram.InstallerType}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Architecture" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProgram.Architecture}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Install location -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource Icon_Folder}"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedProgram.App.InstallLocation, TargetNullValue='Location unknown'}"
                                       FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedProgram.App.InstallLocation}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource DangerButton}" Padding="14,7" FontSize="12"
                                Command="{Binding DataContext.UninstallSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SelectedProgram}"
                                ToolTip="Run the uninstaller, then scan and clean leftovers">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Trash}" Fill="White"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Deep Uninstall" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource GhostButton}" Padding="14,6" FontSize="12" Margin="0,8,0,0"
                                Command="{Binding DataContext.OpenInstallLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SelectedProgram}"
                                ToolTip="Open the installation folder in Explorer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_FolderOpen}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Location" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ BOTTOM ACTION BAR ═══ -->
        <Border Grid.Row="3" Padding="20,8,20,12"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource GlassBackgroundBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                                CornerRadius="6" Padding="10,4" Margin="0,0,16,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text="selected"/>
                            </TextBlock>
                        </Border>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="Total: "/>
                            <Run Text="{Binding SelectedTotalSize, Converter={StaticResource FileSizeConverter}, Mode=OneWay}" FontWeight="Medium"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Clear Selection" Style="{DynamicResource GhostButton}"
                                Command="{Binding ClearSelectionCommand}" Padding="14,8" FontSize="12" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource DangerButton}"
                                Command="{Binding UninstallSelectedCommand}"
                                Padding="16,8" FontSize="12"
                                ToolTip="Deep uninstall all selected programs">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Trash}" Fill="White"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Uninstall Selected" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ═══ SKELETON LOADING OVERLAY ═══ -->
        <Border Grid.RowSpan="4" Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100">
            <Grid Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Skeleton Header -->
                <Border Grid.Row="0" Style="{DynamicResource SkeletonBlock}" Width="140" Height="24" HorizontalAlignment="Left"/>
                <Border Grid.Row="0" Style="{DynamicResource SkeletonBlock}" Width="180" Height="12" HorizontalAlignment="Left" Margin="0,32,0,0"/>
                
                <!-- Skeleton Search Row -->
                <Border Grid.Row="1" Style="{DynamicResource SkeletonBlock}" Width="280" Height="34" HorizontalAlignment="Left" Margin="0,24,0,16"/>
                
                <!-- Skeleton Table Header -->
                <Border Grid.Row="2" Style="{DynamicResource SkeletonBlock}" Height="36" Margin="0,0,0,8" Opacity="0.15"/>
                
                <!-- Skeleton Rows -->
                <StackPanel Grid.Row="3">
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                    <Border Style="{DynamicResource SkeletonBlock}" Height="42" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
