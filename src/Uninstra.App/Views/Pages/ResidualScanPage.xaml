<UserControl x:Class="Uninstra.App.Views.Pages.ResidualScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Residual Scan" FontSize="20" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                            CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Residuals.Count, FallbackValue=0}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Scan and clean leftover files from previous uninstalls" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20,0">
            <Border Background="{DynamicResource GlassBackgroundBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="28" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Leftover files found" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Residuals.Count, FallbackValue=0}" FontSize="48" FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" Margin="0,6"/>
                    <TextBlock Text="Click Scan to find orphaned files and registry entries" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>

                    <Button Content="Scan for Residual Files" Style="{DynamicResource PrimaryButton}"
                            HorizontalAlignment="Center" Padding="24,10" FontSize="13" Margin="0,20,0,0"
                            Command="{Binding ScanCommand}"
                            ToolTip="Scan the registry for broken or orphaned uninstall entries"/>
                </StackPanel>
            </Border>

            <!-- Scanning overlay -->
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="20,0,20,12"/>
    </Grid>
</UserControl>
