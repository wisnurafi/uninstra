<UserControl x:Class="Uninstra.App.Views.Pages.ResidualScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Residual Scan" FontSize="20" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                            CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Residuals.Count, FallbackValue=0}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Scan and clean leftover files from previous uninstalls" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content: selection toolbar + result list OR empty state -->
        <Grid Grid.Row="1">

            <!-- Results -->
            <Grid Margin="20,0"
                  Visibility="{Binding Residuals.Count, Converter={StaticResource CountToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selection toolbar -->
                <Grid Grid.Row="0" Margin="0,10,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{DynamicResource GhostButton}" Padding="12,6"
                            Command="{Binding SelectAllCommand}" ToolTip="Select every found item">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource Icon_SelectAll}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Select All" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Padding="12,6" Margin="6,0,0,0"
                            Command="{Binding ClearSelectionCommand}" ToolTip="Clear selection">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource Icon_ClearSelection}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding SelectedCount, FallbackValue=0}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text=" of " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Residuals.Count, FallbackValue=0, Mode=OneWay}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text=" selected" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Style="{DynamicResource DangerButton}" Padding="16,7" FontSize="12"
                            Command="{Binding CleanSelectedCommand}"
                            ToolTip="Back up registry entries and quarantine or delete the selected items">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource Icon_Trash}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCount, StringFormat='Clean Selected ({0})'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Item list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,8">
                    <ItemsControl ItemsSource="{Binding Residuals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource GlassCard}" CornerRadius="10"
                                        Padding="16,12" Margin="0,0,0,10"
                                        ToolTip="{Binding Details}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection toggle -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <!-- Type icon: file / folder / registry box -->
                                        <Path Grid.Column="1" Data="{Binding TypeIcon}"
                                              Fill="{DynamicResource WarningBrush}" Opacity="0.9"
                                              Width="22" Height="22" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <!-- Name / location / meta -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Location}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}" Opacity="0.75"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="  ·  " FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding ConfidenceScore, StringFormat='{}{0}% confidence'}"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="High" FontSize="10.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           Visibility="{Binding IsHighConfidence, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="Medium" FontSize="10.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding IsMediumConfidence, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="Low" FontSize="10.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.OpenLocationCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource GhostButton}" Padding="12,6" FontSize="12"
                                                VerticalAlignment="Center" Margin="10,0,0,0"
                                                ToolTip="Show this item in File Explorer"
                                                Visibility="{Binding HasOpenableLocation, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{DynamicResource Icon_Browse}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="12" Height="12" Stretch="Uniform"
                                                      Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Show" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Empty state -->
            <Border Margin="20,0" Padding="0,24" VerticalAlignment="Center"
                    Visibility="{Binding Residuals.Count, Converter={StaticResource CountToVisibilityInverse}}">
                <Border Background="{DynamicResource GlassBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="32" HorizontalAlignment="Center" MinWidth="420">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="400">
                        <Path Data="{DynamicResource Icon_ResidualScan}"
                              Fill="{DynamicResource TextMutedBrush}" Opacity="0.4"
                              Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Text="No residual items yet" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <TextBlock Text="Scan the registry for broken uninstallers and missing install locations left behind by removed applications."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,20"/>

                        <Button Content="Scan for Residual Files" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding ScanCommand}"
                                HorizontalAlignment="Center" Padding="24,10" FontSize="13"
                                ToolTip="Scan the registry for broken or orphaned uninstall entries"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Scanning overlay -->
            <Border Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="12"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Cleaning overlay -->
            <Border Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="12"
                    Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText, FallbackValue=Empty}" FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="20,0,20,12"/>
    </Grid>
</UserControl>
