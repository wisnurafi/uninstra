<UserControl x:Class="Uninstra.App.Views.Pages.WindowsAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20,24,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Windows Apps" FontSize="22" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource PrimaryTranslucentBrush}"
                            CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Apps.Count, FallbackValue=0}" FontSize="12"
                                   Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Manage Windows Store apps and built-in system apps" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search -->
        <Border Grid.Row="1" Margin="24,0,24,8">
            <TextBox Style="{StaticResource SearchTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search Windows apps by name or package"/>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,0">
            <DataGrid ItemsSource="{Binding Apps}" IsReadOnly="True"
                      AutoGenerateColumns="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="App Name" Binding="{Binding DisplayName}" Width="*" MinWidth="220"/>
                    <DataGridTextColumn Header="Package" Binding="{Binding PackageFamilyName}" Width="280"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading overlay -->
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="24,8,24,12">
            <DockPanel>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                        DockPanel.Dock="Right" Padding="16,6" FontSize="12"
                        Command="{Binding LoadCommand}" ToolTip="Rescan Windows apps"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
