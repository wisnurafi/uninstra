<UserControl x:Class="Uninstra.App.Views.Pages.JunkCleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Uninstra.App.Converters">
    <UserControl.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20,24,16">
            <StackPanel>
                <TextBlock Text="Junk Cleaner" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Clean temporary files and free up disk space" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,0">
            <StackPanel VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="32,28" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Potential space to reclaim" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalJunkSize, Converter={StaticResource FileSizeConverter}, FallbackValue='0 B'}"
                                   FontSize="42" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,8"/>
                        <TextBlock Text="{Binding Categories.Count, StringFormat={}{0} categories scanned, FallbackValue='Click Scan to start'}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Scan for Junk Files" Style="{StaticResource PrimaryButton}"
                            Padding="28,12" FontSize="14" Margin="0,0,8,0"
                            Command="{Binding ScanCommand}"
                            ToolTip="Scan for temporary and junk files"/>
                    <Button Content="Clean All" Style="{StaticResource DangerButton}"
                            Padding="20,12" FontSize="14"
                            Command="{Binding CleanAllCommand}"
                            ToolTip="Delete all found junk files"/>
                </StackPanel>
            </StackPanel>

            <!-- Scanning overlay -->
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="24,0,24,12"/>
    </Grid>
</UserControl>
