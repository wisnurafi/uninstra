<UserControl x:Class="Uninstra.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
            <!-- Logo -->
            <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,20" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="U" FontSize="40" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Uninstra" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Version 1.0.0" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20"/>

            <TextBlock Text="Deep Uninstaller &amp; Software Cleanup" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Open-source alternative to IObit Uninstaller, built with WPF and .NET 10."
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text=".NET 10  ·  WPF  ·  SQLite  ·  MIT License" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
