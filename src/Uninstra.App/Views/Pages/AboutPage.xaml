<UserControl x:Class="Uninstra.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
            <!-- Logo -->
            <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,20" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Path Data="{DynamicResource Icon_Shield}" Fill="#171717" Width="36" Height="36" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20"/>

            <TextBlock Text="{Binding Tagline}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="Open-source alternative to IObit Uninstaller, built with WPF and .NET 9."
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Tech badges -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text=".NET 9" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text="WPF" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text="SQLite" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="{Binding License}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Button Style="{DynamicResource GhostButton}" Padding="12,8" Margin="0,0,4,0"
                        Command="{Binding OpenGitHubCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource Icon_Github}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Disclaimer -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <TextBlock Text="{Binding Disclaimer}" FontSize="10" 
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

            <!-- Privacy -->
            <TextBlock Text="{Binding Privacy}" FontSize="10" 
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
