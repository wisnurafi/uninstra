<Window x:Class="Uninstra.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstra"
        MinWidth="1100" MinHeight="700"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        StateChanged="Window_StateChanged">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="8" CaptionHeight="32" UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel>
                <!-- Titlebar drag area -->
                <Border DockPanel.Dock="Top" Height="32" Background="Transparent"/>
                
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="16,0,16,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                                    <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{DynamicResource Icon_Shield}" Fill="#171717" Width="16" Height="16" Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="UNINSTRA" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Deep Uninstaller" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                    <StackPanel Margin="0,0,0,4">
                        <!-- PROGRAMS Section -->
                        <TextBlock Text="PROGRAMS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="16,8,0,6"/>
                        
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" IsChecked="True" Click="NavButton_Click" Tag="Programs">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Programs}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="All Programs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="Programs_Recent">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_History}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Recently Installed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="Programs_Large">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Large Programs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,12"/>

                        <!-- TOOLS Section -->
                        <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="16,8,0,6"/>
                        
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="SoftwareHealth">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_SoftwareHealth}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Software Health" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="InstallMonitor">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_InstallMonitor}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Install Monitor" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="ForceUninstall">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_ForceUninstall}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Force Uninstall" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="ResidualScan">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_ResidualScan}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Residual Scan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="WindowsApps">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_WindowsApps}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Windows Apps" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="BrowserExtensions">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_BrowserExtensions}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browser Extensions" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="JunkCleaner">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_JunkCleaner}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Junk Cleaner" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="16,12"/>

                        <!-- SYSTEM Section -->
                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="16,8,0,6"/>
                        
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="Quarantine">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Quarantine}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quarantine" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="History">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_History}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="History" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_Settings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarButton}" GroupName="Nav" Click="NavButton_Click" Tag="About">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource Icon_About}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Version -->
                <Border DockPanel.Dock="Bottom" Padding="16,12">
                    <TextBlock Text="v1.0.0 · .NET 9" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══ RIGHT PANE ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="{DynamicResource Icon_Minimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowChromeButton}" Click="Maximize_Click" ToolTip="Maximize">
                        <Path x:Name="MaximizeIcon" Data="{DynamicResource Icon_Maximize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                        <Path Data="{DynamicResource Icon_Close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                <ContentControl x:Name="PageContent" Margin="8,0"/>
            </Border>
        </Grid>
    </Grid>
</Window>
