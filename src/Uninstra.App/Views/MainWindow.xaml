<Window x:Class="Uninstra.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Uninstra.App.Views.Pages"
        Title="Uninstra — Deep Uninstaller &amp; Software Cleanup"
        MinWidth="1100" MinHeight="700"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo / Brand -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="8"
                                    Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                                        <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="U" FontSize="16" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="UNINSTRA" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Deep Uninstaller" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Version badge -->
                <Border DockPanel.Dock="Bottom" Padding="20,12">
                    <TextBlock Text="v1.0.0  ·  .NET 10" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="PROGRAMS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="24,8,0,6"/>

                        <RadioButton Style="{StaticResource SidebarButton}" Content="All Programs"
                                     GroupName="Nav" IsChecked="True"
                                     Click="NavButton_Click" Tag="Programs"
                                     ToolTip="View and manage all installed programs"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Recently Installed"
                                     GroupName="Nav" Click="NavButton_Click" Tag="Programs_Recent"
                                     ToolTip="Programs installed in the last 30 days"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Large Programs"
                                     GroupName="Nav" Click="NavButton_Click" Tag="Programs_Large"
                                     ToolTip="Programs using the most disk space"/>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="20,10"/>

                        <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="24,8,0,6"/>

                        <RadioButton Style="{StaticResource SidebarButton}" Content="Software Health"
                                     GroupName="Nav" Click="NavButton_Click" Tag="SoftwareHealth"
                                     ToolTip="Analyze your software for issues and recommendations"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Install Monitor"
                                     GroupName="Nav" Click="NavButton_Click" Tag="InstallMonitor"
                                     ToolTip="Monitor new installations in real-time"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Force Uninstall"
                                     GroupName="Nav" Click="NavButton_Click" Tag="ForceUninstall"
                                     ToolTip="Remove programs that can't be normally uninstalled"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Residual Scan"
                                     GroupName="Nav" Click="NavButton_Click" Tag="ResidualScan"
                                     ToolTip="Scan and clean leftover files from previous uninstalls"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Windows Apps"
                                     GroupName="Nav" Click="NavButton_Click" Tag="WindowsApps"
                                     ToolTip="Manage Windows Store and built-in apps"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Browser Extensions"
                                     GroupName="Nav" Click="NavButton_Click" Tag="BrowserExtensions"
                                     ToolTip="Manage extensions across all browsers"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Junk Cleaner"
                                     GroupName="Nav" Click="NavButton_Click" Tag="JunkCleaner"
                                     ToolTip="Clean temporary files and free disk space"/>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="20,10"/>

                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="24,8,0,6"/>

                        <RadioButton Style="{StaticResource SidebarButton}" Content="Quarantine"
                                     GroupName="Nav" Click="NavButton_Click" Tag="Quarantine"
                                     ToolTip="View quarantined files that can be restored"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="History"
                                     GroupName="Nav" Click="NavButton_Click" Tag="History"
                                     ToolTip="View past uninstall and cleanup history"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="Settings"
                                     GroupName="Nav" Click="NavButton_Click" Tag="Settings"
                                     ToolTip="Configure application preferences"/>
                        <RadioButton Style="{StaticResource SidebarButton}" Content="About"
                                     GroupName="Nav" Click="NavButton_Click" Tag="About"
                                     ToolTip="About Uninstra"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <ContentControl x:Name="PageContent" Margin="0"/>
        </Border>
    </Grid>
</Window>
