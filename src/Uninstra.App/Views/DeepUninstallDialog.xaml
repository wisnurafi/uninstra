<Window x:Class="Uninstra.App.Views.DeepUninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Uninstra.App.Converters"
        Title="Deep Uninstall — Leftover Cleanup"
        Width="860" Height="580" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- ═══ REVIEW PHASE ═══ -->
        <Grid x:Name="ReviewPanel" Visibility="{Binding Phase, Converter={StaticResource BoolToVis}, ConverterParameter=notdone}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                                    <GradientStop Color="{StaticResource PrimaryLightColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{DynamicResource Icon_Search}" Fill="#171717" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="Deep Uninstall: "/>
                                <Run Text="{Binding AppName, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Progress bar -->
                <ProgressBar Grid.Row="1" Height="3" Margin="0,0,0,12"
                             IsIndeterminate="{Binding IsWorking}"
                             Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"/>

                <!-- Leftover items list -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Leftovers}" IsReadOnly="True"
                              AutoGenerateColumns="False"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionMode="Single" CanUserSortColumns="True"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="50" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsProtected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="90"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="80"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="70"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Location}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Selection summary -->
                <Border Grid.Row="3" Background="{DynamicResource GlassBackgroundBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,10" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                <Run Text="{Binding TotalFound, Mode=OneWay}"/>
                                <Run Text="found ·"/>
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                                <Run Text="selected ("/>
                                <Run Text="{Binding SelectedSize, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="All" Style="{DynamicResource GhostButton}"
                                    Command="{Binding SelectAllCommand}" Margin="0,0,2,0" Padding="8,4"/>
                            <Button Content="Recommended" Style="{DynamicResource GhostButton}"
                                    Command="{Binding SelectRecommendedCommand}" Margin="0,0,2,0" Padding="8,4"/>
                            <Button Content="None" Style="{DynamicResource GhostButton}"
                                    Command="{Binding DeselectAllCommand}" Padding="8,4"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Bottom buttons -->
                <DockPanel Grid.Row="4" Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clean Selected" Style="{DynamicResource PrimaryButton}"
                                Command="{Binding CleanSelectedCommand}"
                                IsEnabled="{Binding CanClean}"
                                Margin="0,0,8,0" Padding="18,8"
                                ToolTip="Delete all selected leftover items"/>
                        <Button Content="Skip" Style="{DynamicResource SecondaryButton}"
                                Click="CloseButton_Click" Padding="14,8"
                                ToolTip="Skip cleanup — leftover files will remain"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ═══ COMPLETION PHASE ═══ -->
        <Grid x:Name="CompletionPanel" Visibility="Collapsed">
            <Border Background="{DynamicResource BackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <!-- Success icon -->
                    <Border Width="72" Height="72" CornerRadius="36" Margin="0,0,0,20" HorizontalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}">
                        <Path Data="{DynamicResource Icon_Check}" Fill="#171717" Width="32" Height="32" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Cleanup Complete!" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="CompletionSubtitle" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <!-- Stats cards -->
                    <Border Background="{DynamicResource GlassBackgroundBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="24,16" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="StatCleaned" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Cleaned" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Height="36" Background="{DynamicResource DividerBrush}"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="StatFailed" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Failed" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Height="36" Background="{DynamicResource DividerBrush}"/>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock x:Name="StatFreed" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource InfoBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Freed" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Content="Done" Style="{DynamicResource PrimaryButton}"
                            Click="CloseButton_Click" Padding="32,10"
                            HorizontalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
